<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════
         List View — color-coded by state
    ══════════════════════════════════════════════════════════════ -->
    <record id="view_hr_document_list" model="ir.ui.view">
        <field name="name">hr.document.list</field>
        <field name="model">hr.document</field>
        <field name="arch" type="xml">
            <list string="Documents &amp; Licenses"
                  decoration-danger="state in ('expired', 'critical')"
                  decoration-warning="state == 'warning'"
                  decoration-success="state == 'valid'"
                  multi_edit="1"
                  default_order="expiry_date asc">
                <field name="document_type_id"/>
                <field name="name" string="Document #"/>
                <field name="entity_type" optional="hide"/>
                <field name="employee_id" optional="show"/>
                <field name="partner_id" optional="hide"/>
                <field name="issue_date" optional="show"/>
                <field name="expiry_date"/>
                <field name="days_remaining"/>
                <field name="state" widget="badge"
                       decoration-danger="state in ('expired', 'critical')"
                       decoration-warning="state == 'warning'"
                       decoration-success="state == 'valid'"/>
                <field name="responsible_id" optional="show"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <button name="action_send_notification_now"
                        string="Notify Now"
                        type="object"
                        icon="fa-envelope"
                        title="Send expiry notification email now"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         Form View
    ══════════════════════════════════════════════════════════════ -->
    <record id="view_hr_document_form" model="ir.ui.view">
        <field name="name">hr.document.form</field>
        <field name="model">hr.document</field>
        <field name="arch" type="xml">
            <form string="Document &amp; License">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="valid,warning,critical,expired"
                           readonly="1"/>
                    <button name="action_mark_renewed"
                            string="Mark as Renewed | تجديد"
                            type="object"
                            class="btn-primary"
                            confirm="This will reset all notification flags so new alerts will be sent. Confirm?"
                            invisible="state == 'valid'"/>
                    <button name="action_send_notification_now"
                            string="Send Notification Now"
                            type="object"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object"
                                class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button"
                                   options='{"terminology": "archive"}'/>
                        </button>
                    </div>

                    <!-- Status Banner -->
                    <div class="alert alert-danger mb-3" role="alert"
                         invisible="state not in ('expired', 'critical')">
                        <i class="fa fa-exclamation-triangle" title="Critical Alert"/>
                        <span invisible="state != 'expired'">
                            <strong>This document has EXPIRED! Please renew immediately.
                            | هذه الوثيقة منتهية! يرجى التجديد فوراً.</strong>
                        </span>
                        <span invisible="state != 'critical'">
                            <strong>CRITICAL — Only <field name="days_remaining" readonly="1" class="d-inline"/> days remaining!
                            | حرج — لم يتبقَّ سوى أيام قليلة!</strong>
                        </span>
                    </div>
                    <div class="alert alert-warning mb-3" role="alert"
                         invisible="state != 'warning'">
                        <i class="fa fa-clock-o" title="Warning"/>
                        Warning — <field name="days_remaining" readonly="1" class="d-inline"/> days remaining.
                        | تحذير — تبقّى <field name="days_remaining" readonly="1" class="d-inline"/> يوم.
                    </div>

                    <group>
                        <group string="Document Information | معلومات الوثيقة">
                            <field name="document_type_id"/>
                            <field name="name" string="Document Number / Reference"/>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="days_remaining" readonly="1"/>
                        </group>
                        <group string="Belongs To | يعود إلى">
                            <field name="entity_type" widget="radio"/>
                            <field name="employee_id"
                                   invisible="entity_type != 'employee'"
                                   required="entity_type == 'employee'"/>
                            <field name="partner_id"
                                   invisible="entity_type != 'company'"
                                   required="entity_type == 'company'"/>
                            <field name="responsible_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <group string="Notification Status | حالة الإشعارات" col="6">
                        <field name="notify_90_sent" string="90-day Sent | أُرسل 90"/>
                        <field name="notify_60_sent" string="60-day Sent | أُرسل 60"/>
                        <field name="notify_30_sent" string="30-day Sent | أُرسل 30"/>
                    </group>

                    <notebook>
                        <page string="Notes | ملاحظات" name="notes">
                            <field name="notes"
                                   placeholder="Add internal notes here... / أضف ملاحظاتك الداخلية هنا..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         Kanban View — grouped by state
    ══════════════════════════════════════════════════════════════ -->
    <record id="view_hr_document_kanban" model="ir.ui.view">
        <field name="name">hr.document.kanban</field>
        <field name="model">hr.document</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="state"/>
                <field name="name"/>
                <field name="document_type_id"/>
                <field name="employee_id"/>
                <field name="partner_id"/>
                <field name="expiry_date"/>
                <field name="days_remaining"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="document_type_id"/>
                                    </strong>
                                    <small class="o_kanban_record_subtitle text-muted">
                                        #<field name="name"/>
                                    </small>
                                </div>
                                <div>
                                    <field name="state" widget="badge"
                                           decoration-danger="state in ('expired','critical')"
                                           decoration-warning="state == 'warning'"
                                           decoration-success="state == 'valid'"/>
                                </div>
                            </div>
                            <div t-if="record.employee_id.value" class="d-flex align-items-center gap-1">
                                <i class="fa fa-user" title="Employee"/>
                                <field name="employee_id"/>
                            </div>
                            <div t-if="record.partner_id.value" class="d-flex align-items-center gap-1">
                                <i class="fa fa-building" title="Company"/>
                                <field name="partner_id"/>
                            </div>
                            <div class="mt-1 d-flex align-items-center gap-1">
                                <i class="fa fa-calendar" title="Expiry Date"/>
                                Expires: <field name="expiry_date"/>
                            </div>
                            <div class="mt-1">
                                <t t-if="record.days_remaining.raw_value >= 0">
                                    <span t-attf-class="badge #{record.days_remaining.raw_value &lt;= 30 ? 'bg-danger' : record.days_remaining.raw_value &lt;= 90 ? 'bg-warning text-dark' : 'bg-success'}">
                                        <field name="days_remaining"/> days left
                                    </span>
                                </t>
                                <t t-else="">
                                    <span class="badge bg-secondary">Expired</span>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         Search View
    ══════════════════════════════════════════════════════════════ -->
    <record id="view_hr_document_search" model="ir.ui.view">
        <field name="name">hr.document.search</field>
        <field name="model">hr.document</field>
        <field name="arch" type="xml">
            <search string="Search Documents">
                <field name="name" string="Document Number"/>
                <field name="document_type_id"/>
                <field name="employee_id"/>
                <field name="partner_id"/>
                <field name="responsible_id"/>

                <separator/>

                <filter name="filter_expired" string="Expired | منتهية"
                        domain="[('state','=','expired')]"/>
                <filter name="filter_critical" string="Critical ≤30d | حرج"
                        domain="[('state','=','critical')]"/>
                <filter name="filter_warning" string="Warning ≤90d | تحذير"
                        domain="[('state','=','warning')]"/>
                <filter name="filter_valid" string="Valid | سارية"
                        domain="[('state','=','valid')]"/>

                <separator/>

                <filter name="filter_my" string="My Responsible | مسؤوليتي"
                        domain="[('responsible_id','=',uid)]"/>
                <filter name="filter_employee" string="Employee Documents | موظفون"
                        domain="[('entity_type','=','employee')]"/>
                <filter name="filter_company" string="Company Documents | الشركة"
                        domain="[('entity_type','=','company')]"/>

                <separator/>

                <filter name="filter_inactive" string="Archived | مؤرشف"
                        domain="[('active','=',False)]"/>

                <group expand="0" string="Group By | تجميع">
                    <filter name="group_type" string="Document Type"
                            context="{'group_by': 'document_type_id'}"/>
                    <filter name="group_state" string="Status | الحالة"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_employee" string="Employee | الموظف"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_responsible" string="Responsible | المسؤول"
                            context="{'group_by': 'responsible_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════
         Window Action
    ══════════════════════════════════════════════════════════════ -->
    <record id="action_hr_document" model="ir.actions.act_window">
        <field name="name">Documents &amp; Licenses | الوثائق والتصاريح</field>
        <field name="res_model">hr.document</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_hr_document_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No documents tracked yet | لا توجد وثائق مسجّلة بعد
            </p>
            <p>
                Start tracking your employees' and company documents.
                Receive automatic email alerts before they expire!<br/>
                <br/>
                ابدأ بتتبّع وثائق موظفيك وشركتك.
                ستصلك تنبيهات تلقائية قبل انتهاء صلاحيتها!
            </p>
        </field>
    </record>

    <!-- Shortcut action for expired/critical only -->
    <record id="action_hr_document_alerts" model="ir.actions.act_window">
        <field name="name">Document Alerts | تنبيهات الوثائق</field>
        <field name="res_model">hr.document</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_hr_document_search"/>
        <field name="domain">[('state', 'in', ['expired', 'critical', 'warning'])]</field>
        <field name="context">{'search_default_filter_expired': 1, 'search_default_filter_critical': 1}</field>
    </record>

</odoo>

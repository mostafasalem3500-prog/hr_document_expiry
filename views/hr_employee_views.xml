<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_documents" model="ir.ui.view">
        <field name="name">hr.employee.form.document.expiry</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_documents" type="object"
                        class="oe_stat_button" icon="fa-id-card-o"
                        groups="hr.group_hr_user">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="document_count"/>
                        </span>
                        <span class="o_stat_text">Documents</span>
                        <span class="o_stat_text text-danger" invisible="not document_alert_count">
                            <field name="document_alert_count"/> need action
                        </span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>

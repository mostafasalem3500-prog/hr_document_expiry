<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="email_template_expiry_90" model="mail.template">
        <field name="name">Document Expiry — 90 Days Warning</field>
        <field name="model_id" ref="model_hr_document"/>
        <field name="subject">⚠️ Expiry Notice (90 days): {{ object.document_type_id.name }} — {{ object.name }}</field>
        <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="email_to">{{ object.responsible_id.email or object.employee_id.work_email or object.partner_id.email or '' }}</field>
        <field name="lang">{{ object.responsible_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div style="font-family:Arial,Tahoma,sans-serif;max-width:600px;margin:0 auto;">
  <div style="background:#2c7be5;padding:22px 30px;border-radius:8px 8px 0 0;">
    <h1 style="color:#ffffff;margin:0;font-size:20px;">⚠️ Document Expiry Reminder — 90 Days</h1>
  </div>
  <div style="background:#f8f9fa;padding:26px 30px;border:1px solid #dee2e6;border-top:none;">
    <p style="color:#495057;font-size:15px;">Hello <strong t-out="object.responsible_id.name or 'HR Team'"/>,</p>
    <p style="color:#495057;font-size:15px;">This is a reminder that the following document will expire soon. Please plan its renewal.</p>
    <div style="background:#ffffff;border:1px solid #dee2e6;border-left:5px solid #2c7be5;border-radius:6px;padding:18px;margin:18px 0;">
      <table style="width:100%;border-collapse:collapse;">
              <tr>
                <td style="padding:6px 0;color:#6c757d;width:40%;">Document Type:</td>
                <td style="padding:6px 0;color:#212529;font-weight:bold;"><t t-out="object.document_type_id.name"/></td>
              </tr>
              <tr>
                <td style="padding:6px 0;color:#6c757d;width:40%;">Document Number:</td>
                <td style="padding:6px 0;color:#212529;font-weight:bold;"><t t-out="object.name"/></td>
              </tr>
              <tr t-if="object.employee_id">
                <td style="padding:6px 0;color:#6c757d;">Employee:</td>
                <td style="padding:6px 0;color:#212529;font-weight:bold;"><t t-out="object.employee_id.name"/></td>
              </tr>
              <tr t-if="object.partner_id">
                <td style="padding:6px 0;color:#6c757d;">Related Partner:</td>
                <td style="padding:6px 0;color:#212529;font-weight:bold;"><t t-out="object.partner_id.name"/></td>
              </tr>
              <tr>
                <td style="padding:6px 0;color:#6c757d;width:40%;">Expiry Date:</td>
                <td style="padding:6px 0;color:#dc3545;font-weight:bold;"><t t-out="format_date(object.expiry_date)"/></td>
              </tr>
              <tr>
                <td style="padding:6px 0;color:#6c757d;">Days Remaining:</td>
                <td style="padding:6px 0;"><span style="background:#2c7be5;color:#fff;padding:2px 10px;border-radius:12px;font-weight:bold;"><t t-out="object.days_remaining"/> days</span></td>
              </tr>
      </table>
    </div>
    <hr style="border:none;border-top:1px solid #dee2e6;margin:22px 0;"/>
    <div style="direction:rtl;text-align:right;">
      <p style="color:#495057;font-size:15px;">تذكير: الوثيقة التالية ستنتهي قريباً، يرجى التخطيط لتجديدها.</p>
      <p style="color:#495057;font-size:15px;">الأيام المتبقية: <strong style="color:#2c7be5;" t-out="object.days_remaining"/> يوماً</p>
      <p style="color:#6c757d;font-size:14px;">
        <strong>نوع الوثيقة:</strong> <t t-out="object.document_type_id.name"/><br/>
        <strong>رقم الوثيقة:</strong> <t t-out="object.name"/><br/>
        <strong>تاريخ الانتهاء:</strong> <t t-out="format_date(object.expiry_date)"/>
      </p>
    </div>
  </div>
  <div style="background:#343a40;padding:14px 30px;border-radius:0 0 8px 8px;text-align:center;">
    <p style="color:#adb5bd;font-size:12px;margin:0;">
      Sent automatically by Document &amp; License Expiry Notifier for Odoo<br/>
      أُرسل تلقائياً بواسطة منبّه انتهاء الوثائق والتصاريح
    </p>
  </div>
</div>
        </field>
    </record>


<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_document_expiry_check" model="ir.cron">
        <field name="name">Document Expiry: Daily Notification Check | فحص انتهاء الوثائق اليومي</field>
        <field name="model_id" ref="model_hr_document"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_expiry()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="nextcall" eval="(DateTime.now().replace(hour=8, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="priority">5</field>
    </record>

</odoo>
